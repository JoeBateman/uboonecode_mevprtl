BEGIN_PROLOG

empty_kaon: {
  tool_type: EmptyKaonGen
}


bnb_kaon: {
  tool_type: "BNBKaonGen" # BooNe Ntuples
  SearchPath: "/cvmfs/sbn.osgstorage.org/pnfs/fnal.gov/usr/uboone/persistent/users/jbateman/bnbflux/"
  FluxFiles: ["*.root"]
  TreeName: "h101"
  MetaTreeName: "meta"
  MaxFluxFileMB: 8192 # 8GB
  FluxCopyMethod: DIRECT
  RandomizeFiles: false
  Verbose: false
}


# Using /exp/uboone/app/users/zarko/windowRotation/correctWindow.c
# TVector3 userpos(1.24325, -0.0093, -463.363525);
# Need to implement:
# rot.RotateX(0.016/10.712);
# rot.RotateY(0.036/10.712);

uboone_bnb_beam2detector_rotation: [ 1, 0, 0,
                                   0, 1, 0,
                                   0, 0, 1] #bnb to sbnd is in z-direction, only need a translation.
# uboone_bnb_beam_origin: [1.24325*100, -0.0093*100, -463.363525*100] # cm in beam in deterctor frame
uboone_bnb_beam_origin: [0, 0, 0, -124.325, 0.93, 46336.3525] # cm in detector in beam frame

# 1036 cm (Z) x 2.56 (X) x 2.32 (Y) - David C. on slack
uboone_detector_box: [0, 256, -116, 116, 0, 1036] #cm
uboone_bnb_solid_angle_box: 2.766e-5 #front face / detector distance ^2 = 2.56*2.32/463.4^2



# sbnd_detector_box: [-200, 200, -200, 200, 0, 500] #cm
# sbnd_bnb_solid_angle_box: 1.3223e-3 #front face / detector distance ^2 = 4*4/110^2
# sbnd_bnb_solid_angle_cryostat: 0.0133 


kaon_energy: 8 #GeV Max energy from kaon 
kaon_pdg: 321 #K+

ray_trace_box: {
  tool_type: RayTraceBox
  Box: @local::uboone_detector_box
  Verbose: false
}

rethrow_ray_trace_box: {
  tool_type: ReThrowRayTraceBox
  Box: @local::uboone_detector_box
  ReferenceLabSolidAngle: @local::uboone_bnb_solid_angle_box
  ReferencePrimaryEnergy: @local::kaon_energy
  ReferencePrimPDG: @local::kaon_pdg
  Verbose: false
}

weighted_ray_trace_box: {
  tool_type: WeightedRayTraceBox
  Box: @local::uboone_detector_box
  ReferenceLabSolidAngle: @local::uboone_bnb_solid_angle_box
  ReferencePrimaryEnergy: @local::kaon_energy 
  ReferencePrimPDG: @local::kaon_pdg
  Verbose: false
}

mixedweight_ray_trace_box: {
  tool_type: MixedWeightRayTraceBox
  Box: @local::uboone_detector_box
  ReferenceLabSolidAngle: @local::uboone_bnb_solid_angle_box
  ReferencePrimaryEnergy: @local::kaon_energy
  ReferencePrimPDG: @local::kaon_pdg
  MaxWeightFudge: 2.
  NThrow: 250
  FixNSuccess: false
  Verbose: false
}


hnlM: 0.265

#FLUX CONFIGS
kaon2hnl: {
  tool_type: Kaon2HNLFlux
  M: @local::hnlM # GeV/c^2
  MagUe4: 0
  MagUm4: 1e-7
  KDAROnly: false
  Target2Absorber: 5000 #cm decay horn length
  MaxImportanceWeight: 1 #BNB gsimple flat weight at 1

  Beam2DetectorRotation: @local::uboone_bnb_beam2detector_rotation # uBooNE & SBND detector rotation is the same
  # sbnd_bnb_beam_origin: [0, 0, 0, 73.78, 0, 11000] # cm in detector in beam frame

  BeamOrigin: @local::uboone_bnb_beam_origin 

  // timing config
  # Bunch sigma taken from 
  # https://beamdocs.fnal.gov/AD/DocDB/0050/005000/001/bunchLength_1st_draft.pdf
  # Bunch spacing taken from
  # https://inspirehep.net/files/610a942fd8632bbbca2c8ad90da86670
  SpillTimeConfig:  "evgb::EvtTimeFNALBeam  booster,  dtbucket=18.936, sigma=1.308"
  GlobalTimeOffset: 0
  Verbose: false
}

# RAY TRACE CONFIGS
mcraytrace: @local::rethrow_ray_trace_box
mcraytrace.ReferencePrtlMass: @local::hnlM # GeV
mcraytrace.ReferenceScndPDG: 13 # muon
mcraytrace.NThrows: 250 

wgtraytrace: @local::weighted_ray_trace_box
wgtraytrace.ReferencePrtlMass: @local::hnlM # GeV
wgtraytrace.ReferenceScndPDG: 13 # muon

mxdraytrace: @local::mixedweight_ray_trace_box
mxdraytrace.ReferencePrtlMass: @local::hnlM # GeV
mxdraytrace.ReferenceScndPDG: 13 # muon


#DECAY CONFIGS
decay_hnl: {
  tool_type: HNLMakeDecay
  Decays: ["mu_pi"]
  Majorana: true
  DecayIsThreeBodyAnisotropic: true
  TwoBodyAnisotropyIncludeInterference: false
  ReferenceUE4: 0
  ReferenceUT4: 0
  ReferenceUM4: 1e-7
  ReferenceHNLMass: @local::hnlM
  ReferenceRayLength: 7.549834e2 # sqrt(57) = 7.549834 = diagonal length of detector
  ReferenceRayDistance: 110e2 #110m = distance from beam target to detector
  ReferenceHNLEnergyFromKaonEnergy: @local::kaon_energy
  WidthDecays: ["mu_pi", "e_pi", "nu_mu_mu", "nu_e_e", "nu_nu_nu", "nu_pi0", "nu_eta", "nu_etap", "nu_rho0", "nu_mu_e"]
  Verbose: false
}

# KDAR CONFIGS
kaon2hnl_kdar: @local::kaon2hnl
kaon2hnl_kdar.KDAROnly: true

decay_hnl_kdar: @local::decay_hnl
decay_hnl_kdar.ReferenceHNLEnergyFromKaonEnergy: 0.494

mxdraytrace_kdar: @local::mixedweight_ray_trace_box
mxdraytrace_kdar.ReferenceKaonEnergy: 0.494
mxdraytrace_kdar.ReferencePrtlMass: @local::hnlM # GeV
mxdraytrace_kdar.ReferenceScndPDG: 13 # muon

#FULL GEN CONFIGS
hnl_gen: {
  module_type: MeVPrtlGen
  Deweight: false
  Produce: true
  AnaOutput: true
  Verbose: false
  MesonGen: @local::bnb_kaon
  Flux: @local::kaon2hnl
  RayTrace: @local::mxdraytrace
  Decay: @local::decay_hnl
}

hnl_gen_kdar: {
  module_type: MeVPrtlGen
  Deweight: false
  Produce: true
  AnaOutput: true
  Verbose: false
  MesonGen: @local::bnb_kaon
  Flux: @local::kaon2hnl_kdar
  RayTrace: @local::mxdraytrace_kdar
  Decay: @local::decay_hnl_kdar
}

hnl_test_raytrace: {
  module_type: MeVPrtlTestRayTrace
  MesonGen: @local::bnb_kaon
  Flux: @local::kaon2hnl
  RayTraces: [
    @local::mcraytrace
    , @local::wgtraytrace
    , @local::mxdraytrace
  ]
}

END_PROLOG