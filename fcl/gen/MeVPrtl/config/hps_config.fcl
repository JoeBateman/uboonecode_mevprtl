#include "bnb_kaon_uboone.fcl"
BEGIN_PROLOG

#Flux CONFIGS

hpsM: 0.2

kaon2hps: {
    tool_type: Kaon2HiggsFlux
    M: @local::hpsM # GeV/c^2
    MixingAngle: 1e-3
    IgnoreParentDecayTime: false
    KDIFOnly: false
    KDAROnly: false # KDAR from ABSORBER ONLY!
    KDIFandBeamline: false # KDIF & non-absorber KDAR - orthogonal to KDAR only

    MaxImportanceWeight: 1 #BNB gsimple flat weight at 1

    Beam2DetectorRotation: @local::uboone_bnb_beam2detector_rotation # uBooNE & SBND detector rotation is the same
    # sbnd_bnb_beam_origin: [0, 0, 0, 73.78, 0, 11000] # cm in detector in beam frame

    BeamOrigin: @local::uboone_bnb_beam_origin 

    // timing config
    # Bunch sigma taken from 
    # https://beamdocs.fnal.gov/AD/DocDB/0050/005000/001/bunchLength_1st_draft.pdf
    # Bunch spacing taken from
    # https://inspirehep.net/files/610a942fd8632bbbca2c8ad90da86670
    SpillTimeConfig:  "evgb::EvtTimeFNALBeam  booster,  dtbucket=18.936, sigma=1.308"
    GlobalTimeOffset: 0
    Verbose: false
}

# RAY TRACE CONFIGS
mcraytrace: @local::rethrow_ray_trace_box
mcraytrace.ReferencePrtlMass: @local::hpsM # GeV
mcraytrace.NThrows: 250 
mcraytrace.ReferenceScndPDG: 211 # pion

wgtraytrace: @local::weighted_ray_trace_box
wgtraytrace.ReferencePrtlMass: @local::hpsM # GeV
wgtraytrace.ReferenceScndPDG: 211 # pion


mxdraytrace: @local::mixedweight_ray_trace_box
mxdraytrace.ReferencePrtlMass: @local::hpsM # GeV
mxdraytrace.ReferenceScndPDG: 211 # pion

#Decay CONFIGS

decay_hps: {
    tool_type: HiggsMakeDecay
    AllowElectronDecay: true
    AllowMuonDecay: true
    AllowPionDecay: true
    AllowPi0Decay: true
    AddTimeOfFlight: true

    ReferenceRayLength: 10.92e2 # sqrt(119.3) = 10.92 = diagonal length of detector
    ReferenceRayDistance: 463.36e2 # 463.36m = distance from beam target to detector
    ReferenceHiggsMass: @local::hpsM
    ReferenceHiggsMixing: 1e-3
    # ReferenceHiggsEnergy: not set in dissonant_hps, leaving for now
    ReferenceHiggsEnergyFromKaonEnergy: @local::kaon_energy
    Verbose: false
}


# Separate KDAR configs
kaon2hps_kdar: @local::kaon2hps
kaon2hps_kdar.ReferenceHNLEnergyFromKaonEnergy:  0.494

mxdraytrace_kdar: @local::mixedweight_ray_trace_box
mxdraytrace_kdar.ReferenceKaonEnergy: 0.494
mxdraytrace_kdar.ReferencePrtlMass: @local::hpsM # GeV

# Full Gen configs
hps_gen: {
    module_type: MeVPrtlGen
    Deweight: false
    Produce: true
    AnaOutput: true
    Verbose: false
    MesonGen: @local::bnb_kaon
    Flux: @local::kaon2hps
    RayTrace: @local::mxdraytrace
    Decay: @local::decay_hps
}

hps_gen_kdar: {
    module_type: MeVPrtlGen
    Deweight: false
    Produce: true
    AnaOutput: true
    Verbose: false
    MesonGen: @local::bnb_kaon
    Flux: @local::kaon2hps_kdar
    RayTrace: @local::mxdraytrace_kdar
    Decay: @local::decay_hps
}

hps_test_raytrace: {
    module_type: MeVPrtlTestRayTrace
    MesonGen: @local::bnb_kaon
    Flux: @local::kaon2hps
    RayTraces: [
    @local::mcraytrace
    , @local::wgtraytrace
    , @local::mxdraytrace
  ]
}

END_PROLOG