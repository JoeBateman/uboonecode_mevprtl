### Modifying prodMeVPrtl_hnl_nupi0_m_200_Um4_1p00e7_TPC_sbnd.fcl ###
#include "prodMeVPrtl_hnl_numi_uboone_overlay.fcl"

#do not inherit clock configuration from the data
services.DetectorClocksService.InheritClockConfig: false

#use generator settings from prodgenie_bnb_nu_uboone.fcl
physics.producers.generator.GlobalTimeOffset: 3125.
physics.producers.generator.RandomTimeOffset: 1600.
physics.producers.generator.TopVolume: "volCryostat"
physics.producers.generator.BeamName: "booster"

###----------Set mass of HNL [GeV]----------###
hnlM: 0.03
physics.producers.generator.Flux.M: @local::hnlM
physics.producers.generator.RayTrace.ReferencePrtlMass: @local::hnlM
physics.producers.generator.Decay.ReferenceHNLMass: @local::hnlM

###----------Set mixing angle of HNL ----------###
Ume4: 0
Umu4: 1.00e-7
Umt4: 0
physics.producers.generator.Flux.MagUe4: @local::Ume4
physics.producers.generator.Flux.MagUm4: @local::Umu4
physics.producers.generator.Decay.ReferenceUE4: @local::Ume4
physics.producers.generator.Decay.ReferenceUM4: @local::Umu4
physics.producers.generator.Decay.ReferenceUT4: @local::Umt4
physics.producers.generator.Decay.Decays: ["nu_e_e"] # ["mu_pi", "e_pi", "nu_mu_mu", "nu_e_e", "nu_nu_nu", "nu_pi0", "nu_eta", "nu_etap", "nu_rho0", "nu_mu_e"]

physics.producers.generator.FluxCopyMethod: "IFDH"

#reduce file name length
outputs.out1.fileName: "%ifb_%tc_gen.root"