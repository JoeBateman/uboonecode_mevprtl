#include "hnl_numi_config.fcl"

# service configuration
#include "largeantmodules_microboone.fcl"
#include "mcreco.fcl"
#include "time_memory_tracker_microboone.fcl"
#include "services_microboone.fcl"
#include "genie_microboone_default+MEC.fcl"
#include "microboone_siminfomixer.fcl"


services:
{
  scheduler:    { defaultExceptions: false }    # Make all uncaught exceptions fatal.
  @table::microboone_simulation_services
  TFileService: { fileName: "hists_prodMeVPrtl_HNL_NuMI_uboone_%p-%tc.root" }
  IFDH: {}
  TimeTracker:             @local::microboone_time_tracker
  MemoryTracker:           @local::microboone_memory_tracker
  RandomNumberGenerator: {} #ART native random number generator
  FileCatalogMetadata:  @local::art_file_catalog_mc
  @table::microboone_g4_services
}

process_name: OverlayMeVPrtlGenBNB

source:
{
  module_type: RootInput
  saveMemoryObjectThreshold: 0
  maxEvents: -1
}

physics:
{
  producers:
  {
    rns:       { module_type: "RandomNumberSaver" }
    generator: @local::hnl_gen
  }
 
  simulate:  [ rns, generator ]
  stream: [ out ]

  mixer_path : [ generator, largeant, ionization, mcreco ]
  trigger_paths : [ mixer_path ]

  # trigger_paths: [ simulate ]
  end_paths:     [ stream ] 
  

  
} # physics



outputs: 
{
  out:
  {
    module_type: RootOutput
    fileName: "prodMeVPrtl_HNL_uboone_%p-%tc.root" # default file name, can override from command line with -o or --output
    dataTier: "generated"
    compressionLevel: 1
    #  SelectEvents: ["mixer_path"]
  }
}

services.NuRandomService.policy: "random"

#do not inherit clock configuration from the data
services.DetectorClocksService.InheritClockConfig: false

#use generator settings from prodgenie_numi_nu_uboone_rhc.fcl
physics.producers.generator.POTPerSpill:        6e13
physics.producers.generator.EventsPerSpill:     0
physics.producers.generator.GlobalTimeOffset:   5627.5
physics.producers.generator.RandomTimeOffset:   9600.
physics.producers.generator.TopVolume:          "volCryostat"
physics.producers.generator.BeamName:           "numi"

physics.producers.generator.FluxCopyMethod: "DIRECT"

#reduce file name length
outputs.out.fileName: "%ifb_gen.root"